{
  "name": "@gagansd/pi-subagents",
  "version": "0.0.1",
  "description": "Tiny yet powerful, benchmarked sub-agents for Pi",
  "license": "MIT",
  "type": "module",
  "author": "Gagan Devagiri",
  "keywords": [
    "pi-package",
    "pi",
    "subagents"
  ],
  "homepage": "https://github.com/GaganSD/pi-extensions/tree/main/pi-subagents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GaganSD/pi-extensions.git",
    "directory": "pi-subagents"
  },
  "exports": { ".": "./index.ts" },
  "files": ["index.ts", "src/**/*.ts", "agents/*.md", "README.md", "VISION.md", "LICENSE", "CHANGELOG.md"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "node ../node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "test:unit": "node ../scripts/test-package.mjs pi-subagents unit",
    "test:integration": "node ../scripts/test-package.mjs pi-subagents integration",
    "build": "node ../scripts/package.mjs pi-subagents",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run check && npm run pack:check"
  },
  "engines": { "node": ">=22.19.0" },
  "pi": { "extensions": ["./index.ts"] },
  "peerDependencies": {
    "@earendil-works/pi-ai": "~1.0.0",
    "@earendil-works/pi-coding-agent": "~1.0.0",
    "@earendil-works/pi-tui": "~1.0.0",
    "typebox": "~1.3.27"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true },
    "typebox": { "optional": true }
  },
  "dependencies": { "yaml": "2.8.3" },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "typebox": "1.3.27"
  }
}

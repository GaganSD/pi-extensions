{
  "name": "@gagansd/pi-web-search",
  "version": "0.1.0",
  "description": "web_search tool for Pi backed by Exa, Parallel, grep.app and GitHub. Optional Jev ranking via TypeSafe or Vercel AI Gateway.",
  "type": "module",
  "license": "MIT",
  "author": "Gagan Devagiri",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "web-search",
    "exa",
    "parallel",
    "jev"
  ],
  "homepage": "https://github.com/GaganSD/pi-extensions/tree/main/pi-web-search",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GaganSD/pi-extensions.git",
    "directory": "pi-web-search"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "25.6.0",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}

{
  "name": "@gagansd/pi-web-search",
  "version": "0.2.0",
  "description": "Search the web and public code from Pi, with citations. web_search, code_search, and opt-in multi_search — keyless by default, no vendor lock-in.",
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "license": "MIT",
  "author": "Gagan Devagiri",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "web-search",
    "exa",
    "parallel",
    "jev"
  ],
  "homepage": "https://github.com/GaganSD/pi-extensions/tree/main/pi-web-search",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GaganSD/pi-extensions.git",
    "directory": "pi-web-search"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "llms.txt",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --experimental-strip-types scripts/test.ts",
    "typecheck": "tsc --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "pack:check": "node --experimental-strip-types scripts/pack-check.ts",
    "prepublishOnly": "npm test && npm run typecheck && npm run pack:check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.99.0",
    "@earendil-works/pi-coding-agent": "0.99.0",
    "@earendil-works/pi-tui": "0.99.0",
    "@types/node": "25.6.0",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}

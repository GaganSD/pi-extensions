{
  "name": "@gagansd/pi-web-search",
  "version": "0.2.0",
  "description": "Search the web and public code from Pi, with citations. web_search, code_search, and opt-in multi_search — keyless by default, no vendor lock-in.",
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "license": "MIT",
  "author": "Gagan Devagiri",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "web-search",
    "exa",
    "parallel",
    "jev"
  ],
  "homepage": "https://github.com/GaganSD/pi-extensions/tree/main/pi-web-search",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GaganSD/pi-extensions.git",
    "directory": "pi-web-search"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "llms.txt",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --experimental-strip-types scripts/test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "node ../node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "test:unit": "node ../scripts/test-package.mjs pi-web-search unit",
    "test:integration": "node ../scripts/test-package.mjs pi-web-search integration",
    "build": "node ../scripts/package.mjs pi-web-search",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "pack:check": "node --experimental-strip-types scripts/pack-check.ts",
    "smoke:live": "node --experimental-strip-types scripts/live-smoke.ts",
    "prepublishOnly": "npm run audit:prod && npm test && npm run typecheck && npm run pack:check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true },
    "typebox": { "optional": true }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "26.6.3",
    "typebox": "1.3.34",
    "typescript": "7.0.2"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}

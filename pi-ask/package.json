{
  "name": "@gagansd/pi-ask",
  "version": "0.1.3",
  "description": "TUI interviews for Pi. Ask one decision at a time.",
  "type": "module",
  "license": "MIT",
  "author": "Gagan Devagiri",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "ask_user",
    "terminal-ui",
    "tui"
  ],
  "homepage": "https://github.com/GaganSD/pi-extensions/tree/main/pi-ask",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GaganSD/pi-extensions.git",
    "directory": "pi-ask"
  },
  "files": [
    "assets",
    "skills",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "llms.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "node ../node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "test:unit": "node ../scripts/test-package.mjs pi-ask unit",
    "test:integration": "node ../scripts/test-package.mjs pi-ask integration",
    "build": "node ../scripts/package.mjs pi-ask",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "overrides": {
    "undici": "8.10.2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@types/node": "26.6.3",
    "typebox": "1.3.34",
    "typescript": "7.0.2"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}

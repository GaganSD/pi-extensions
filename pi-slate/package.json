{
  "name": "pi-slate",
  "version": "0.1.5",
  "description": "Quiet Pi TUI: header, footer, sidebar, and a muted dark theme.",
  "type": "module",
  "license": "MIT",
  "author": "Gagan Devagiri",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-theme",
    "terminal-ui",
    "tui",
    "sidebar",
    "theme"
  ],
  "homepage": "https://www.npmjs.com/package/pi-slate",
  "files": [
    "assets",
    "extensions",
    "themes",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types tests/**/*.test.ts tests/**/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-slate/index.ts"
    ],
    "themes": [
      "./themes/*.json"
    ],
    "image": "https://cdn.jsdelivr.net/npm/pi-slate@0.1.4/assets/slate-overview.png"
  }
}
